# Copy to .env (gitignored) and fill in.
# Get the Client ID from https://developer.spotify.com/dashboard after
# creating an app with redirect URI http://127.0.0.1:8765/callback.

SPOTIFY_CLIENT_ID=""

# Optional — if 8765 collides with another service on your machine, set a
# different port here AND update the redirect URI in the Spotify dev-app
# dashboard to match.
# SPOTIFY_REDIRECT_PORT=8766
